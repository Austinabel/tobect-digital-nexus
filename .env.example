# Copy this file to .env.local and fill in the values from your Supabase
# dashboard. .env.local is git-ignored — never commit real keys.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → publishable key (safe in the browser; protected by row-level security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings → API Keys → secret key.
# SERVER ONLY — never prefix with NEXT_PUBLIC_, never paste into chat or code.
SUPABASE_SECRET_KEY=

# Connect → Connection string → Session pooler (includes the DB password).
# Used by `npm run db` for migrations and schema inspection.
DATABASE_URL=

# First-run admin setup: a secret code (16+ characters) that lets the first
# signed-in user claim the site at /admin/setup. Only works while no owner
# exists; you can remove it afterwards.
ADMIN_SETUP_TOKEN=

# Card payments (optional). Paystack Dashboard → Settings → API Keys & Webhooks
# → Secret key (sk_live_… for real payments, sk_test_… for testing).
# SERVER ONLY. While empty, checkout offers "pay on confirmation" only.
PAYSTACK_SECRET_KEY=

# Product scanning (optional): staff photograph a product or its label and the
# details are read and filled in for them to check. Anthropic Console →
# API keys (https://console.anthropic.com). SERVER ONLY. Each scan costs a few
# naira of API usage. While empty, staff still get photo upload, barcode
# reading on supported phones, and duplicate checks.
ANTHROPIC_API_KEY=
